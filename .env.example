# InsurMinds Apólice Analyzer - Configurações de Ambiente

# Chave de API do Google Gemini (Google AI Studio)
GOOGLE_API_KEY=sua_chave_aqui

# Modelos LLM e Visão Multimodal
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# Parâmetros de Ingestão e Armazenamento
MAX_FILE_SIZE_MB=50
DB_PATH=./data/apolices.db
UPLOAD_DIR=./data/uploads

# Logging e Servidor
LOG_LEVEL=INFO
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8503
